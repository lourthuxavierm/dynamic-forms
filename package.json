{
  "name": "dynamic-forms",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent dynamic forms monorepo",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint packages apps scripts --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "docs:dev": "pnpm --filter @dynamic-forms/docs dev",
    "docs:build": "pnpm --filter @dynamic-forms/docs build",
    "docs:preview": "pnpm --filter @dynamic-forms/docs preview",
    "docs:api": "pnpm --filter @dynamic-forms/docs api",
    "docs:api:check": "pnpm --filter @dynamic-forms/docs api:check",
    "docs:governance": "pnpm --filter @dynamic-forms/docs governance",
    "docs:health": "pnpm --filter @dynamic-forms/docs health",
    "docs:examples:capture": "pnpm --filter @dynamic-forms/docs examples:capture",
    "docs:verify": "pnpm --filter @dynamic-forms/docs verify",
    "docs:test": "pnpm --filter @dynamic-forms/docs test:smoke",
    "builder:e2e": "pnpm --filter @dynamic-forms/form-builder test:e2e",
    "verify:react-html-release": "node scripts/verify-react-html-release.mjs",
    "verify:zod-architecture": "pnpm --filter @dynamic-forms/docs zod:architecture",
    "verify:zod-release": "node scripts/verify-zod-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "latest",
    "@testing-library/react": "latest",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "latest",
    "tsup": "latest",
    "turbo": "latest",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "latest",
    "vitepress": "latest",
    "vitest": "latest"
  }
}
