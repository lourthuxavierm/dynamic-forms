{
    "name":  "@dynamic-forms/devtools",
    "version":  "0.1.0",
    "description":  "Developer tools for Dynamic Forms",
    "license":  "MIT",
    "main":  "./dist/index.js",
    "module":  "./dist/index.mjs",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.mjs",
                              "require":  "./dist/index.js"
                          }
                },
    "files":  [
                  "dist"
              ],
    "dependencies":  {
                         "@dynamic-forms/core":  "workspace:*",
                         "@dynamic-forms/react":  "workspace:*"
                     },
    "scripts":  {
                    "build":  "tsup",
                    "test":  "vitest run",
                    "typecheck":  "tsc --noEmit"
                }
}
