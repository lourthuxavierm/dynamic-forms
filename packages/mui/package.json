{
    "name":  "@dynamic-forms/mui",
    "version":  "0.1.0",
    "description":  "Material UI adapter for Dynamic Forms",
    "license":  "MIT",
    "main":  "./dist/index.js",
    "module":  "./dist/index.mjs",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.mjs",
                              "require":  "./dist/index.js"
                          }
                },
    "files":  [
                  "dist"
              ],
    "peerDependencies":  {
                             "@emotion/react":  "^11.0.0",
                             "@emotion/styled":  "^11.0.0",
                             "@mui/material":  "^7.0.0",
                             "react":  "^18.0.0 || ^19.0.0",
                             "react-dom":  "^18.0.0 || ^19.0.0"
                         },
    "dependencies":  {
                         "@dynamic-forms/core":  "workspace:*",
                         "@dynamic-forms/react":  "workspace:*"
                     },
    "scripts":  {
                    "build":  "tsup \u0026\u0026 tsc -p tsconfig.build.json",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run"
                },
    "devDependencies":  {
                            "@emotion/react":  "^11.14.0",
                            "@emotion/styled":  "^11.14.1",
                            "@mui/material":  "^7.3.11",
                            "@testing-library/react":  "^16.3.2",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "happy-dom":  "^20.11.6",
                            "vitest":  "^4.1.11"
                        },
    "sideEffects":  false
}