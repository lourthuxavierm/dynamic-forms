{
  "name": "@lourthuxavierm/dynamic-forms-react-html",
  "version": "0.1.0",
  "description": "Accessible native HTML adapter for Dynamic Forms",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": { "types": "./dist/entries/core.d.ts", "import": "./dist/core.mjs", "require": "./dist/core.js" },
    "./controls/baseline": { "types": "./dist/entries/baseline.d.ts", "import": "./dist/baseline.mjs", "require": "./dist/baseline.js" },
    "./controls/text": { "types": "./dist/entries/text.d.ts", "import": "./dist/text.mjs", "require": "./dist/text.js" },
    "./controls/composites": { "types": "./dist/entries/composites.d.ts", "import": "./dist/composites.mjs", "require": "./dist/composites.js" },
    "./controls/specialized": { "types": "./dist/entries/specialized.d.ts", "import": "./dist/specialized.mjs", "require": "./dist/specialized.js" },
    "./controls/temporal": { "types": "./dist/entries/temporal.d.ts", "import": "./dist/temporal.mjs", "require": "./dist/temporal.js" },
    "./controls/media": { "types": "./dist/entries/media.d.ts", "import": "./dist/media.mjs", "require": "./dist/media.js" },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "peerDependencies": {
    "@lourthuxavierm/dynamic-forms-core": "workspace:*",
    "@lourthuxavierm/dynamic-forms-react": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests && node scripts/verify-styles.mjs",
    "performance": "pnpm build && node scripts/verify-performance.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lourthuxavierm/dynamic-forms-core": "workspace:*",
    "@lourthuxavierm/dynamic-forms-react": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.11.6"
  }
}
