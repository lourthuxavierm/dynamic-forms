{
  "name": "@dynamic-form-engine/react-html",
  "version": "0.1.0",
  "description": "Accessible native HTML adapter for Dynamic Forms",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./controls/baseline": {
      "types": "./dist/entries/baseline.d.ts",
      "import": "./dist/baseline.js",
      "require": "./dist/baseline.cjs"
    },
    "./controls/text": {
      "types": "./dist/entries/text.d.ts",
      "import": "./dist/text.js",
      "require": "./dist/text.cjs"
    },
    "./controls/composites": {
      "types": "./dist/entries/composites.d.ts",
      "import": "./dist/composites.js",
      "require": "./dist/composites.cjs"
    },
    "./controls/specialized": {
      "types": "./dist/entries/specialized.d.ts",
      "import": "./dist/specialized.js",
      "require": "./dist/specialized.cjs"
    },
    "./controls/temporal": {
      "types": "./dist/entries/temporal.d.ts",
      "import": "./dist/temporal.js",
      "require": "./dist/temporal.cjs"
    },
    "./controls/media": {
      "types": "./dist/entries/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@dynamic-form-engine/core": "workspace:*",
    "@dynamic-form-engine/react": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests && node scripts/verify-styles.mjs",
    "performance": "pnpm build && node scripts/verify-performance.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dynamic-form-engine/core": "workspace:*",
    "@dynamic-form-engine/react": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.11.6"
  },
  "keywords": [
    "dynamic-forms",
    "dynamic-form",
    "form-engine",
    "schema-form",
    "schema-driven",
    "dynamic-ui",
    "form-builder",
    "headless-form",
    "typescript",
    "form-validation",
    "conditional-fields",
    "form-state"
  ],
  "author": {
    "name": "Lourthu Xavier M",
    "url": "https://github.com/lourthuxavierm"
  },
  "contributors": [],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/lourthuxavierm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lourthuxavierm/dynamic-forms.git",
    "directory": "packages/react-html"
  },
  "homepage": "https://github.com/lourthuxavierm/dynamic-forms#readme",
  "bugs": {
    "url": "https://github.com/lourthuxavierm/dynamic-forms/issues"
  },
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@10.15.0"
}
