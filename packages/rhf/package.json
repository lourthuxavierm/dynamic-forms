{
    "name": "@dynamic-form-engine/rhf",
    "version": "0.1.0",
    "description": "React Hook Form adapter for Dynamic Forms",
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-hook-form": "^7.0.0"
    },
    "dependencies": {
        "@dynamic-form-engine/core": "workspace:*",
        "@dynamic-form-engine/react": "workspace:*"
    },
    "scripts": {
        "build": "tsup && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "happy-dom": "^20.11.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.85.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false
}
