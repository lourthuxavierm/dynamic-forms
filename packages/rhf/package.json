                          }
                },
    "files":  [
                  "dist"
              ],
    "peerDependencies":  {
                             "react":  "^18.0.0 || ^19.0.0",
                             "react-hook-form":  "^7.0.0"
                         },
    "dependencies":  {
                         "@dynamic-forms/core":  "workspace:*"
                     },
    "scripts":  {
                    "build":  "tsup",
                    "test":  "vitest run",
                    "typecheck":  "tsc --noEmit"
                }
}
