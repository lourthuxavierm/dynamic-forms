{
    "name":  "@dynamic-form-engine/zod",
    "version":  "0.1.0",
    "description":  "Zod validation adapter for Dynamic Forms",
    "license":  "MIT",
    "publishConfig":  { "access": "public" },
    "main":  "./dist/index.js",
    "module":  "./dist/index.mjs",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.mjs",
                              "require":  "./dist/index.js"
                          }
                },
    "files":  [
                  "dist",
                  "README.md",
                  "RELEASE.md"
              ],
    "sideEffects":  false,
    "peerDependencies":  {
                             "zod":  "^3.25.5 || ^4.0.0"
                         },
    "dependencies":  {
                         "@dynamic-form-engine/core":  "workspace:*"
                     },
    "scripts":  {
                    "build":  "tsup && tsc -p tsconfig.build.json",
                    "test":  "vitest run",
                    "typecheck":  "tsc --noEmit -p tsconfig.json"
                },
    "devDependencies":  {
                             "zod":  "4.4.3"
                         }
}
